# ---- R1: TemaPorPalavraChave ----
<urn:swrl#a> rdf:type swrl:Variable .
<urn:swrl#k> rdf:type swrl:Variable .
<urn:swrl#t> rdf:type swrl:Variable .
_:R1 rdf:type swrl:Imp ;
    rdfs:label "R1_TemaPorPalavraChave" ;
    rdfs:comment "Deriva abordaTecnica a partir das palavras-chave do artigo: se o artigo tem uma palavra-chave igual a uma palavraChaveAssociada de um tema, ele aborda esse tema. Une sinônimos em PT, EN e ES."@pt ;
    swrla:isRuleEnabled "true"^^xsd:boolean ;
    swrl:body _:R1b1 ;
    swrl:head _:R1h1 .
_:R1b1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Artigo ; swrl:argument1 <urn:swrl#a> ] ;
    rdf:rest _:R1b2 .
_:R1b2 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :palavraChave ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#k> ] ;
    rdf:rest _:R1b3 .
_:R1b3 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :palavraChaveAssociada ; swrl:argument1 <urn:swrl#t> ; swrl:argument2 <urn:swrl#k> ] ;
    rdf:rest rdf:nil .
_:R1h1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :abordaTecnica ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#t> ] ;
    rdf:rest rdf:nil .

# ---- R2: CoocorrenciaDeTemas ----
<urn:swrl#a> rdf:type swrl:Variable .
<urn:swrl#t1> rdf:type swrl:Variable .
<urn:swrl#t2> rdf:type swrl:Variable .
_:R2 rdf:type swrl:Imp ;
    rdfs:label "R2_CoocorrenciaDeTemas" ;
    rdfs:comment "Dois temas distintos abordados pelo mesmo artigo são temaRelacionadoCom. Depende de R1 (abordaTecnica derivada)."@pt ;
    swrla:isRuleEnabled "true"^^xsd:boolean ;
    swrl:body _:R2b1 ;
    swrl:head _:R2h1 .
_:R2b1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Artigo ; swrl:argument1 <urn:swrl#a> ] ;
    rdf:rest _:R2b2 .
_:R2b2 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :abordaTecnica ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#t1> ] ;
    rdf:rest _:R2b3 .
_:R2b3 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :abordaTecnica ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#t2> ] ;
    rdf:rest _:R2b4 .
_:R2b4 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DifferentIndividualsAtom ; swrl:argument1 <urn:swrl#t1> ; swrl:argument2 <urn:swrl#t2> ] ;
    rdf:rest rdf:nil .
_:R2h1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :temaRelacionadoCom ; swrl:argument1 <urn:swrl#t1> ; swrl:argument2 <urn:swrl#t2> ] ;
    rdf:rest rdf:nil .

# ---- R3: ArtigoInterinstitucional ----
<urn:swrl#a> rdf:type swrl:Variable .
<urn:swrl#i> rdf:type swrl:Variable .
<urn:swrl#j> rdf:type swrl:Variable .
<urn:swrl#ni> rdf:type swrl:Variable .
<urn:swrl#nj> rdf:type swrl:Variable .
<urn:swrl#nx> rdf:type swrl:Variable .
<urn:swrl#ny> rdf:type swrl:Variable .
<urn:swrl#x> rdf:type swrl:Variable .
<urn:swrl#y> rdf:type swrl:Variable .
_:R3 rdf:type swrl:Imp ;
    rdfs:label "R3_ArtigoInterinstitucional" ;
    rdfs:comment "Artigo com dois autores distintos (nomes diferentes) afiliados a instituições de nomes diferentes. Autores com dupla afiliação podem inflar a contagem, pois SWRL não tem negação."@pt ;
    swrla:isRuleEnabled "true"^^xsd:boolean ;
    swrl:body _:R3b1 ;
    swrl:head _:R3h1 .
_:R3b1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Artigo ; swrl:argument1 <urn:swrl#a> ] ;
    rdf:rest _:R3b2 .
_:R3b2 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :temAutor ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#x> ] ;
    rdf:rest _:R3b3 .
_:R3b3 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :temAutor ; swrl:argument1 <urn:swrl#a> ; swrl:argument2 <urn:swrl#y> ] ;
    rdf:rest _:R3b4 .
_:R3b4 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :nome ; swrl:argument1 <urn:swrl#x> ; swrl:argument2 <urn:swrl#nx> ] ;
    rdf:rest _:R3b5 .
_:R3b5 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :nome ; swrl:argument1 <urn:swrl#y> ; swrl:argument2 <urn:swrl#ny> ] ;
    rdf:rest _:R3b6 .
_:R3b6 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:notEqual ; swrl:arguments ( <urn:swrl#nx> <urn:swrl#ny> ) ] ;
    rdf:rest _:R3b7 .
_:R3b7 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :afiliadoA ; swrl:argument1 <urn:swrl#x> ; swrl:argument2 <urn:swrl#i> ] ;
    rdf:rest _:R3b8 .
_:R3b8 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :afiliadoA ; swrl:argument1 <urn:swrl#y> ; swrl:argument2 <urn:swrl#j> ] ;
    rdf:rest _:R3b9 .
_:R3b9 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :nomeInstituicao ; swrl:argument1 <urn:swrl#i> ; swrl:argument2 <urn:swrl#ni> ] ;
    rdf:rest _:R3b10 .
_:R3b10 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :nomeInstituicao ; swrl:argument1 <urn:swrl#j> ; swrl:argument2 <urn:swrl#nj> ] ;
    rdf:rest _:R3b11 .
_:R3b11 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:notEqual ; swrl:arguments ( <urn:swrl#ni> <urn:swrl#nj> ) ] ;
    rdf:rest rdf:nil .
_:R3h1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ArtigoInterinstitucional ; swrl:argument1 <urn:swrl#a> ] ;
    rdf:rest rdf:nil .

# ---- R4: InstituicaoParticipouDaEdicao ----
<urn:swrl#e> rdf:type swrl:Variable .
<urn:swrl#inst> rdf:type swrl:Variable .
<urn:swrl#it> rdf:type swrl:Variable .
<urn:swrl#x> rdf:type swrl:Variable .
_:R4 rdf:type swrl:Imp ;
    rdfs:label "R4_InstituicaoParticipouDaEdicao" ;
    rdfs:comment "Se um autor afiliado a uma instituição assina um item publicado em uma edição, a instituição participouDe essa edição (junção de 3 relações; também expressável em OWL 2 por propertyChainAxiom, mas aqui fica como regra SWRL)."@pt ;
    swrla:isRuleEnabled "true"^^xsd:boolean ;
    swrl:body _:R4b1 ;
    swrl:head _:R4h1 .
_:R4b1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :temAutor ; swrl:argument1 <urn:swrl#it> ; swrl:argument2 <urn:swrl#x> ] ;
    rdf:rest _:R4b2 .
_:R4b2 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :afiliadoA ; swrl:argument1 <urn:swrl#x> ; swrl:argument2 <urn:swrl#inst> ] ;
    rdf:rest _:R4b3 .
_:R4b3 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :publicadoEm ; swrl:argument1 <urn:swrl#it> ; swrl:argument2 <urn:swrl#e> ] ;
    rdf:rest rdf:nil .
_:R4h1 rdf:type swrl:AtomList ;
    rdf:first [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :participouDe ; swrl:argument1 <urn:swrl#inst> ; swrl:argument2 <urn:swrl#e> ] ;
    rdf:rest rdf:nil .


# ==========================================================
# HIERARQUIA EXPLÍCITA DAS CLASSES DEFINIDAS (v7)
# ==========================================================
# Cada classe abaixo já é subclasse de Artigo por ser definida como
# "Artigo e (restrição)". O raciocinador DL deduz isso sozinho; aqui o fato
# é declarado também de forma explícita para que visualizadores e motores de
# regras simples (que não classificam por equivalência) mostrem a hierarquia.
:ArtigoSobreModelagem rdfs:subClassOf :Artigo .
:ArtigoSobreElicitacao rdfs:subClassOf :Artigo .
:ArtigoColaborativo rdfs:subClassOf :Artigo .
:ArtigoDeAutoriaUnica rdfs:subClassOf :Artigo .
:ArtigoMultitematico rdfs:subClassOf :Artigo .
:ArtigoEmPortugues rdfs:subClassOf :Artigo .
:ArtigoEmLinguaEstrangeira rdfs:subClassOf :Artigo .

# ==========================================================
# NOTAS SOBRE MODELAGEM
# ==========================================================
# 1. Prefácio e Tutorial não possuem DOI na planilha WER2026 e, por isso,
#    não são instâncias de Artigo; são ItemEspecial.
# 2. doi é funcional e Artigo possui cardinalidade exatamente 1 de DOI.
# 3. palavraChave NÃO é funcional: um artigo pode ter várias palavras-chave.
# 4. afiliadoA NÃO é funcional: um autor pode ter várias instituições.
# 5. possuiAutor é a inversa de afiliadoA; uma Instituicao tem pelo menos um autor.
# 6. localidade, isbn e issn são funcionais por edição, mas seus valores podem
#    ser repetidos entre diferentes edições.
# 7. A classificação de TipoDeContribuicao é opcional, pois não é fornecida
#    pela planilha; "Tipo" da planilha é modelado por pertenceATrilha.
# 8. Regras SWRL R1-R4 estão na seção "REGRAS SWRL". R1 preenche abordaTecnica a
#    partir de palavraChave + palavraChaveAssociada; R2-R4 derivam temaRelacionadoCom,
#    ArtigoInterinstitucional e participouDe.
# 9. GORE foi adicionado como tema porque 2 artigos têm palavras-chave de GORE.
# 10. owl:differentFrom entre temas é explícito apenas para o motor de regras.
# 11. (v7) As 7 classes definidas por equivalência receberam subClassOf Artigo explícito,
#     e o comentário da R4 foi corrigido (a junção também é expressável por propertyChainAxiom).
# 12. Nós anônimos (blank nodes) são parte normal do OWL: restrições, intersectionOf,
#     AllDifferent e regras SWRL são serializados assim. Visualizadores devem interpretá-los,
#     não desenhá-los como nós do grafo.
