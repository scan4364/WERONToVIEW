@prefix : <http://www.cin.ufpe.br/ontologias/wer-catalogo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .

<http://www.cin.ufpe.br/ontologias/wer-catalogo>
    rdf:type owl:Ontology ;
    rdfs:comment "Ontologia do catálogo de publicações do WER - versão revisada com dados WER 2026."@pt ;
    rdfs:label "Ontologia WER Catálogo"@pt .

# ==========================================================
# CLASSES
# ==========================================================

:ItemDoEvento rdf:type owl:Class ;
    rdfs:label "Item do Evento"@pt ;
    rdfs:comment "Item publicado ou disponibilizado em uma edição do WER, incluindo artigos, prefácio e tutorial."@pt .

:Artigo rdf:type owl:Class ;
    rdfs:subClassOf :ItemDoEvento ;
    rdfs:label "Artigo"@pt ;
    rdfs:comment "Artigo científico identificado por um DOI."@pt .

:ItemEspecial rdf:type owl:Class ;
    rdfs:subClassOf :ItemDoEvento ;
    rdfs:label "Item Especial"@pt ;
    rdfs:comment "Item da edição que não é modelado como Artigo porque não possui DOI no corpus atual, como Prefácio e Tutorial."@pt .

:Autor rdf:type owl:Class ;
    rdfs:label "Autor"@pt .

:Edicao rdf:type owl:Class ;
    rdfs:label "Edição"@pt ;
    rdfs:comment "Uma edição/ano do WER."@pt .

:Instituicao rdf:type owl:Class ;
    rdfs:label "Instituição"@pt .

:TemaDePesquisa rdf:type owl:Class ;
    rdfs:label "Tema de Pesquisa"@pt ;
    rdfs:comment "Técnica, framework ou linha de pesquisa em Engenharia de Requisitos."@pt .

:TecnicaDeModelagem rdf:type owl:Class ;
    rdfs:subClassOf :TemaDePesquisa ;
    rdfs:label "Técnica de Modelagem"@pt .

:TecnicaDeElicitacao rdf:type owl:Class ;
    rdfs:subClassOf :TemaDePesquisa ;
    rdfs:label "Técnica de Elicitação"@pt .

:TecnicaDeValidacao rdf:type owl:Class ;
    rdfs:subClassOf :TemaDePesquisa ;
    rdfs:label "Técnica de Validação"@pt .

:TecnicaDeIA rdf:type owl:Class ;
    rdfs:subClassOf :TemaDePesquisa ;
    rdfs:label "Técnica de Inteligência Artificial"@pt .

:TemaDePrivacidadeEEtica rdf:type owl:Class ;
    rdfs:subClassOf :TemaDePesquisa ;
    rdfs:label "Tema de Privacidade e Ética"@pt .

:TipoDeContribuicao rdf:type owl:Class ;
    rdfs:label "Tipo de Contribuição"@pt .

:Idioma rdf:type owl:Class ;
    rdfs:label "Idioma"@pt .

:Trilha rdf:type owl:Class ;
    rdfs:label "Trilha"@pt .

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :ItemDoEvento :Autor :Edicao :Instituicao :TemaDePesquisa ) .

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :Artigo :ItemEspecial ) .

[] rdf:type owl:AllDisjointClasses ;
    owl:members ( :TecnicaDeModelagem :TecnicaDeElicitacao :TecnicaDeValidacao
                  :TecnicaDeIA :TemaDePrivacidadeEEtica ) .

# ==========================================================
# OBJECT PROPERTIES
# ==========================================================

:temAutor rdf:type owl:ObjectProperty ;
    rdfs:label "tem autor"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range :Autor .

:autorDe rdf:type owl:ObjectProperty ;
    owl:inverseOf :temAutor ;
    rdfs:label "autor de"@pt ;
    rdfs:domain :Autor ;
    rdfs:range :ItemDoEvento .

:publicadoEm rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "publicado em"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range :Edicao .

:afiliadoA rdf:type owl:ObjectProperty ;
    rdfs:label "afiliado a"@pt ;
    rdfs:domain :Autor ;
    rdfs:range :Instituicao ;
    rdfs:comment "Não é funcional: um autor pode ter mais de uma instituição."@pt .

:possuiAutor rdf:type owl:ObjectProperty ;
    owl:inverseOf :afiliadoA ;
    rdfs:label "possui autor afiliado"@pt ;
    rdfs:domain :Instituicao ;
    rdfs:range :Autor ;
    rdfs:comment "Inversa de afiliadoA; uma instituição pode ter um ou mais autores afiliados."@pt .

:abordaTecnica rdf:type owl:ObjectProperty ;
    rdfs:label "aborda técnica"@pt ;
    rdfs:comment "Relaciona um artigo a um ou mais temas/técnicas de pesquisa."@pt ;
    rdfs:domain :Artigo ;
    rdfs:range :TemaDePesquisa .

:eAbordadaPor rdf:type owl:ObjectProperty ;
    owl:inverseOf :abordaTecnica ;
    rdfs:label "é abordada por"@pt ;
    rdfs:domain :TemaDePesquisa ;
    rdfs:range :Artigo .

:dependeDe rdf:type owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "depende de"@pt ;
    rdfs:domain :TemaDePesquisa ;
    rdfs:range :TemaDePesquisa .

:temTipoDeContribuicao rdf:type owl:ObjectProperty ;
    rdfs:label "tem tipo de contribuição"@pt ;
    rdfs:domain :Artigo ;
    rdfs:range :TipoDeContribuicao ;
    rdfs:comment "Opcional no corpus atual, pois a planilha fornece a trilha do evento, não uma classificação de contribuição científica."@pt .

:temIdioma rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tem idioma"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range :Idioma .

:pertenceATrilha rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "pertence à trilha"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range :Trilha .

:coautorDe rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "coautor de"@pt ;
    rdfs:domain :Autor ;
    rdfs:range :Autor ;
    owl:propertyChainAxiom ( :autorDe :temAutor ) .

# ==========================================================
# DATA PROPERTIES
# ==========================================================

:titulo rdf:type owl:DatatypeProperty ;
    rdfs:label "título"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range xsd:string .

:ano rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ano"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range xsd:integer .

:nome rdf:type owl:DatatypeProperty ;
    rdfs:label "nome"@pt ;
    rdfs:domain :Autor ;
    rdfs:range xsd:string .

:nomeInstituicao rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "nome da instituição"@pt ;
    rdfs:domain :Instituicao ;
    rdfs:range xsd:string .

:doi rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "DOI"@pt ;
    rdfs:domain :Artigo ;
    rdfs:range xsd:string .

:palavraChave rdf:type owl:DatatypeProperty ;
    rdfs:label "palavra-chave"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range xsd:string ;
    rdfs:comment "Um item pode ter uma ou várias palavras-chave; a propriedade não é funcional."@pt .

:link rdf:type owl:DatatypeProperty ;
    rdfs:label "link"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range xsd:anyURI .

:linkPagina rdf:type owl:DatatypeProperty ;
    rdfs:label "link da página"@pt ;
    rdfs:domain :ItemDoEvento ;
    rdfs:range xsd:anyURI .

:linkEdicao rdf:type owl:DatatypeProperty ;
    rdfs:label "link da edição"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range xsd:anyURI .

:localidade rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "localidade"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range xsd:string ;
    rdfs:comment "Uma edição tem uma localidade. O mesmo valor pode ser reutilizado em várias edições; não há restrição de unicidade."@pt .

:isbn rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ISBN"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range xsd:string ;
    rdfs:comment "Identificador editorial da edição. Pode coincidir com o valor de outra edição."@pt .

:issn rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "ISSN"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range xsd:string ;
    rdfs:comment "ISSN associado à série dos anais. Pode se repetir entre edições."@pt .

:nomeAlternativo rdf:type owl:DatatypeProperty ;
    rdfs:label "nome alternativo"@pt ;
    rdfs:domain :Autor ;
    rdfs:range xsd:string .

# ==========================================================
# RESTRIÇÕES
# ==========================================================

:ItemDoEvento rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :temAutor ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :Autor
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :publicadoEm ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :temIdioma ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :pertenceATrilha ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :temAutor ;
      owl:allValuesFrom :Autor
    ] .

:Artigo rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :doi ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :palavraChave ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :abordaTecnica ;
      owl:allValuesFrom :TemaDePesquisa
    ] .

:Autor rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :nome ;
      owl:minCardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :afiliadoA ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :Instituicao
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :afiliadoA ;
      owl:allValuesFrom :Instituicao
    ] .

:Instituicao rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :nomeInstituicao ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :possuiAutor ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass :Autor
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :possuiAutor ;
      owl:allValuesFrom :Autor
    ] .

:Edicao rdfs:subClassOf
    [ rdf:type owl:Restriction ;
      owl:onProperty :ano ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :localidade ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :isbn ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ],
    [ rdf:type owl:Restriction ;
      owl:onProperty :issn ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .

:Artigo rdfs:subClassOf [ rdf:type owl:Restriction ;
    owl:onProperty :doi ;
    owl:allValuesFrom xsd:string
] .

:Artigo owl:hasKey ( :doi ) .

# ==========================================================
# CLASSES DEFINIDAS / REASONING
# ==========================================================

:ArtigoSobreModelagem rdf:type owl:Class ;
    rdfs:label "Artigo sobre Modelagem"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ;
              owl:onProperty :abordaTecnica ;
              owl:someValuesFrom :TecnicaDeModelagem ]
        )
    ] .

:ArtigoSobreElicitacao rdf:type owl:Class ;
    rdfs:label "Artigo sobre Elicitação"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ;
              owl:onProperty :abordaTecnica ;
              owl:someValuesFrom :TecnicaDeElicitacao ]
        )
    ] .

:ArtigoColaborativo rdf:type owl:Class ;
    rdfs:label "Artigo Colaborativo"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ;
              owl:onProperty :temAutor ;
              owl:onClass :Autor ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ]
        )
    ] .

:ArtigoDeAutoriaUnica rdf:type owl:Class ;
    rdfs:label "Artigo de Autoria Única"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ;
              owl:onProperty :temAutor ;
              owl:onClass :Autor ;
              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ]
        )
    ] .

:ArtigoMultitematico rdf:type owl:Class ;
    rdfs:label "Artigo Multitemático"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ;
              owl:onProperty :abordaTecnica ;
              owl:onClass :TemaDePesquisa ;
              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ]
        )
    ] .

:ArtigoEmPortugues rdf:type owl:Class ;
    rdfs:label "Artigo em Português"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Restriction ; owl:onProperty :temIdioma ; owl:hasValue :Portugues ]
        )
    ] .

:ArtigoEmLinguaEstrangeira rdf:type owl:Class ;
    rdfs:label "Artigo em Língua Estrangeira"@pt ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Artigo
            [ rdf:type owl:Class ;
              owl:complementOf [ rdf:type owl:Restriction ; owl:onProperty :temIdioma ; owl:hasValue :Portugues ]
            ]
        )
    ] .

# ==========================================================
# VOCABULÁRIO CONTROLADO
# ==========================================================

:Portugues rdf:type owl:NamedIndividual , :Idioma ; rdfs:label "Português"@pt .
:Ingles rdf:type owl:NamedIndividual , :Idioma ; rdfs:label "Inglês"@pt .
:Espanhol rdf:type owl:NamedIndividual , :Idioma ; rdfs:label "Espanhol"@pt .

:TrilhaPesquisa rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Trilha de Pesquisa"@pt .
:TrilhaFerramentas rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Trilha de Ferramentas"@pt .
:TrilhaIndustria rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Indústria"@pt .
:TrilhaMestradoDoutorado rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Mestrado e Doutorado"@pt .
:TrilhaTutorial rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Tutorial"@pt .
:TrilhaPrefacio rdf:type owl:NamedIndividual , :Trilha ; rdfs:label "Prefácio"@pt .

[] rdf:type owl:AllDifferent ;
    owl:distinctMembers ( :Portugues :Ingles :Espanhol ) .

[] rdf:type owl:AllDifferent ;
    owl:distinctMembers ( :TrilhaPesquisa :TrilhaFerramentas :TrilhaIndustria
                          :TrilhaMestradoDoutorado :TrilhaTutorial :TrilhaPrefacio ) .

# Tipos de contribuição mantidos como vocabulário opcional.
:PropostaDeSolucao rdf:type owl:NamedIndividual , :TipoDeContribuicao ;
    rdfs:label "Proposta de Solução"@pt .
:PesquisaDeValidacao rdf:type owl:NamedIndividual , :TipoDeContribuicao ;
    rdfs:label "Pesquisa de Validação"@pt .
:PesquisaDeAvaliacao rdf:type owl:NamedIndividual , :TipoDeContribuicao ;
    rdfs:label "Pesquisa de Avaliação"@pt .
:ArtigoDeExperiencia rdf:type owl:NamedIndividual , :TipoDeContribuicao ;
    rdfs:label "Artigo de Experiência"@pt .
:ArtigoDeOpiniao rdf:type owl:NamedIndividual , :TipoDeContribuicao ;
    rdfs:label "Artigo de Opinião"@pt .

# ==========================================================
# TEMAS DE PESQUISA
# ==========================================================

:Acessibilidade rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Acessibilidade"@pt .
:AplicacoesMoveis rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Aplicações Móveis"@pt .
:AquisicaoDeSoftware rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Aquisição / Licitação de Software"@pt .
:BPM rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "Processos de Negócio (BPM)"@pt .
:CasosDeUso rdf:type owl:NamedIndividual , :TecnicaDeElicitacao ;
    rdfs:label "Cenários / Casos de Uso"@pt .
:CatalogoDeRequisitos rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Catálogo de Requisitos"@pt .
:Competencias rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Competências"@pt .
:Consistencia rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Consistência"@pt .
:ElicitacaoDeRequisitos rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Elicitação de Requisitos"@pt .
:EnsinoDeRE rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Ensino de Engenharia de Requisitos"@pt .
:EspecificacaoDeRequisitos rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Especificação de Requisitos"@pt .
:Explicabilidade rdf:type owl:NamedIndividual , :TemaDePrivacidadeEEtica ;
    rdfs:label "Explicabilidade / Transparência"@pt .
:IAGenerativa rdf:type owl:NamedIndividual , :TecnicaDeIA ;
    rdfs:label "LLM / IA Generativa"@pt .
:LEL rdf:type owl:NamedIndividual , :TecnicaDeElicitacao ;
    rdfs:label "Léxico Estendido da Linguagem (LEL)"@pt .
:MetodosAgeis rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Métodos Ágeis"@pt .
:ModelagemConceitual rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "Modelagem Conceitual"@pt .
:PLN rdf:type owl:NamedIndividual , :TecnicaDeIA ;
    rdfs:label "Processamento de Linguagem Natural"@pt .
:Privacidade rdf:type owl:NamedIndividual , :TemaDePrivacidadeEEtica ;
    rdfs:label "Privacidade de Dados / LGPD"@pt .
:RequisitosNaoFuncionais rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Requisitos Não-Funcionais"@pt .
:RevisaoSistematica rdf:type owl:NamedIndividual , :TemaDePesquisa ;
    rdfs:label "Revisão Sistemática da Literatura"@pt .
:TestesDeSoftware rdf:type owl:NamedIndividual , :TecnicaDeValidacao ;
    rdfs:label "Fuzzing / Testes de Software"@pt .
:UserStories rdf:type owl:NamedIndividual , :TecnicaDeElicitacao ;
    rdfs:label "User Stories"@pt .
:iStar rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "i*/iStar"@pt .

:iStar rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "i*/iStar"@pt .
:Tropos rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "Tropos"@pt ;
    :dependeDe :iStar .
:NFRFramework rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "NFR Framework"@pt .
:KAOS rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "KAOS"@pt .
:Volere rdf:type owl:NamedIndividual , :TecnicaDeElicitacao ;
    rdfs:label "Volere"@pt .

# ==========================================================
# EDIÇÃO WER 2026
# ==========================================================

:edicao2026 rdf:type owl:NamedIndividual , :Edicao ;
    :ano "2026"^^xsd:integer ;
    :localidade "La Plata, Argentina" ;
    :isbn "978-65-02-19591-8" ;
    :issn "2675-0066" ;
    :linkEdicao "https://werpapers.dimap.ufrn.br/proceedings/WER2026/"^^xsd:anyURI ;
    rdfs:label "WER 2026"@pt ;
    rdfs:comment "Edição realizada em La Plata, Argentina. Localidade e ISBN/ISSN verificados no WERpapers e nas páginas de anais do WER 2026."@pt .


# ==========================================================
# INSTITUIÇÕES
# ==========================================================

:instituicaoEscolaPolitecnicaDaUniversidadeDeSaoPauloPoliUSP rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Escola Politécnica da Universidade de São Paulo (Poli-USP)" .
:instituicaoFaculdadeSenacPernambucoSENACPE rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Faculdade Senac Pernambuco (SENAC-PE)" .
:instituicaoIIILIDIInstitutoDeInvestigacionEnInformaticaLIDI rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "III-LIDI (Instituto de Investigación en Informática LIDI)" .
:instituicaoInstitutoFederalGoianoIFGoiano rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Instituto Federal Goiano (IF Goiano)" .
:instituicaoInstitutoFederalDeEducacaoCienciaETecnologiaDoCearaIFCE rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Instituto Federal de Educação, Ciência e Tecnologia do Ceará (IFCE)" .
:instituicaoPUCRio rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "PUC-Rio" .
:instituicaoUniversidadArgentinaDeLaEmpresaUADEINTEC rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Universidad Argentina de la Empresa (UADE) — INTEC" .
:instituicaoUniversidadNacionalDeEntreRiosUNERFacultadDeCienciasDeLaAdministracion rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Universidad Nacional de Entre Ríos (UNER) — Facultad de Ciencias de la Administración" .
:instituicaoUniversidadNacionalDeHurlinghamUNAHUR rdf:type owl:NamedIndividual , :Instituicao ;
    :nomeInstituicao "Universidad Nacional de Hurlingham (UNAHUR)" .
