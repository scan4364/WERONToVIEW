# ==========================================================
# REGRAS SWRL (OWL + SWRL -> Drools)
# ==========================================================

# ----- Novas propriedades e classes (suporte às regras) -----

:palavraChaveAssociada rdf:type owl:DatatypeProperty ;
    rdfs:label "palavra-chave associada"@pt ;
    rdfs:comment "Palavra-chave (em qualquer idioma) que indica que um artigo trata deste tema. Não funcional: um tema pode ter vários sinônimos. Usada pela regra R1."@pt ;
    rdfs:domain :TemaDePesquisa ;
    rdfs:range xsd:string .

:temaRelacionadoCom rdf:type owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "tema relacionado com"@pt ;
    rdfs:comment "Dois temas que aparecem juntos em ao menos um artigo. Derivada pela regra R2."@pt ;
    rdfs:domain :TemaDePesquisa ;
    rdfs:range :TemaDePesquisa .

:participouDe rdf:type owl:ObjectProperty ;
    rdfs:label "participou de"@pt ;
    rdfs:comment "Instituição com ao menos um autor afiliado em item publicado na edição. Derivada pela regra R4."@pt ;
    rdfs:domain :Instituicao ;
    rdfs:range :Edicao .

:temInstituicaoParticipante rdf:type owl:ObjectProperty ;
    owl:inverseOf :participouDe ;
    rdfs:label "tem instituição participante"@pt ;
    rdfs:domain :Edicao ;
    rdfs:range :Instituicao .

:ArtigoInterinstitucional rdf:type owl:Class ;
    rdfs:subClassOf :Artigo ;
    rdfs:label "Artigo Interinstitucional"@pt ;
    rdfs:comment "Artigo com autores de instituições diferentes. Classe preenchida pela regra R3 (subclasse simples, não definida por equivalência, porque a condição exige junção que DL não expressa)."@pt .

# ----- Tema novo, necessário para as palavras-chave de GORE -----
:GORE rdf:type owl:NamedIndividual , :TecnicaDeModelagem ;
    rdfs:label "Engenharia de Requisitos Orientada a Objetivos (GORE)"@pt .

# ----- Palavras-chave associadas a cada tema (tabela usada por R1) -----
:AplicacoesMoveis :palavraChaveAssociada
        "Aplicaciones Móviles 3D" .
:RequisitosNaoFuncionais :palavraChaveAssociada
        "Requerimientos No Funcionales" ,
        "Non-Functional Requirements" .
:LEL :palavraChaveAssociada
        "LEL" ,
        "Léxico Extendido del Lenguaje (LEL)" .
:ElicitacaoDeRequisitos :palavraChaveAssociada
        "Elicitación" ,
        "Elicitação de Requisitos" ,
        "Elicitación de requerimientos" ,
        "Elicitation Data" .
:PLN :palavraChaveAssociada
        "Procesamiento de Lenguaje Natural" ,
        "NLP" .
:IAGenerativa :palavraChaveAssociada
        "Generative Artificial Intelligence" ,
        "Large Language Models" ,
        "LLMs" ,
        "LLM" ,
        "Large Language Models (LLMs)" ,
        "Modelos Generativos" .
:UserStories :palavraChaveAssociada
        "User Stories" ,
        "User Story Mapping" .
:Explicabilidade :palavraChaveAssociada
        "Explainability" ,
        "Explainable Artificial Intelligence" ,
        "AI Transparency" ,
        "Transparency" .
:Privacidade :palavraChaveAssociada
        "Privacy" ,
        "Privacy-Preserving Systems" ,
        "Privacy-by-Design" ,
        "LGPD" ,
        "GDPR" .
:RevisaoSistematica :palavraChaveAssociada
        "Revisão sistemática da literatura" ,
        "Systematic Mapping Study" .
:EnsinoDeRE :palavraChaveAssociada
        "Software Engineering Education" ,
        "Educación en Ingeniería" .
:BPM :palavraChaveAssociada
        "BPMN" ,
        "Business Process Modeling" .
:ModelagemConceitual :palavraChaveAssociada
        "Modelagem conceitual" ,
        "Modelado Conceptual" .
:NFRFramework :palavraChaveAssociada
        "NFR Framework" .
:CasosDeUso :palavraChaveAssociada
        "Escenarios" .
:TestesDeSoftware :palavraChaveAssociada
        "Ethical Fuzzing" ,
        "Fairness Testing" .
:Acessibilidade :palavraChaveAssociada
        "Accessibility Requirements" .
:Competencias :palavraChaveAssociada
        "Aprendizado orientado por competências" .
:EspecificacaoDeRequisitos :palavraChaveAssociada
        "Especificación de Requisitos" .
:MetodosAgeis :palavraChaveAssociada
        "Métodos Ágeis" ,
        "Scrum" .
:GORE :palavraChaveAssociada
        "Goal-oriented Modeling" ,
        "Engenharia de requisitos orientada a objetivos (GORE)" .

# ----- differentFrom explícito entre temas -----
# Necessário para a regra R2 (differentFrom) em motores de regras que não
# expandem o owl:AllDifferent; semanticamente equivale a declarar os temas distintos.
