@prefix : <http://www.cin.ufpe.br/ontologias/wer-catalogo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://www.cin.ufpe.br/ontologias/wer-catalogo#> .

<http://www.cin.ufpe.br/ontologias/wer-catalogo> rdf:type owl:Ontology ;
                                                  rdfs:comment "Ontologia do catálogo de publicações do WER - versão revisada com dados WER 2026."@pt ;
                                                  rdfs:label "Ontologia WER Catálogo"@pt .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
swrla:isRuleEnabled rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.cin.ufpe.br/ontologias/wer-catalogo#abordaTecnica
:abordaTecnica rdf:type owl:ObjectProperty ;
               owl:inverseOf :eAbordadaPor ;
               rdfs:domain :Artigo ,
                           :ItemDoEvento ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :abordaTecnica ;
                             owl:allValuesFrom :TemaDePesquisa
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :temAutor ;
                             owl:allValuesFrom :Autor
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :temAutor ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Autor
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :pertenceATrilha ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :publicadoEm ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :temIdioma ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :doi ;
                             owl:allValuesFrom xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :palavraChave ;
                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :doi ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ;
               rdfs:range :TemaDePesquisa ;
               rdfs:comment "Relaciona um artigo a um ou mais temas/técnicas de pesquisa."@pt ;
               rdfs:label "aborda técnica"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#afiliadoA
:afiliadoA rdf:type owl:ObjectProperty ;
           owl:inverseOf :possuiAutor ;
           rdfs:domain :Autor ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:allValuesFrom :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :nome ;
                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                       ] ;
           rdfs:range :Instituicao ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :possuiAutor ;
                        owl:allValuesFrom :Autor
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :possuiAutor ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Autor
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :nomeInstituicao ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger
                      ] ;
           rdfs:comment "Não é funcional: um autor pode ter mais de uma instituição."@pt ;
           rdfs:label "afiliado a"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#autorDe
:autorDe rdf:type owl:ObjectProperty ;
         owl:inverseOf :temAutor ;
         rdfs:domain :Autor ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :afiliadoA ;
                       owl:allValuesFrom :Instituicao
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :afiliadoA ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Instituicao
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :nome ;
                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                     ] ;
         rdfs:range :ItemDoEvento ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temAutor ;
                      owl:allValuesFrom :Autor
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temAutor ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Autor
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :pertenceATrilha ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :publicadoEm ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temIdioma ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ;
         rdfs:label "autor de"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#coautorDe
:coautorDe rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ;
           rdfs:domain :Autor ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:allValuesFrom :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :nome ;
                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                       ] ;
           rdfs:range :Autor ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :afiliadoA ;
                        owl:allValuesFrom :Instituicao
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :afiliadoA ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Instituicao
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :nome ;
                        owl:minCardinality "1"^^xsd:nonNegativeInteger
                      ] ;
           owl:propertyChainAxiom ( :autorDe
                                    :temAutor
                                  ) ;
           rdfs:label "coautor de"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#dependeDe
:dependeDe rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :TemaDePesquisa ;
           rdfs:range :TemaDePesquisa ;
           rdfs:label "depende de"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#eAbordadaPor
:eAbordadaPor rdf:type owl:ObjectProperty ;
              rdfs:domain :TemaDePesquisa ;
              rdfs:range :Artigo ,
                         :ItemDoEvento ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :abordaTecnica ;
                           owl:allValuesFrom :TemaDePesquisa
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temAutor ;
                           owl:allValuesFrom :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temAutor ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :pertenceATrilha ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :publicadoEm ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temIdioma ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :doi ;
                           owl:allValuesFrom xsd:string
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :palavraChave ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :doi ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
              rdfs:label "é abordada por"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#participouDe
:participouDe rdf:type owl:ObjectProperty ;
              owl:inverseOf :temInstituicaoParticipante ;
              rdfs:domain :Instituicao ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :possuiAutor ;
                            owl:allValuesFrom :Autor
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :possuiAutor ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Autor
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :nomeInstituicao ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ;
              rdfs:range :Edicao ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :ano ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :isbn ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :issn ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :localidade ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
              rdfs:comment "Instituição com ao menos um autor afiliado em item publicado na edição. Derivada pela regra R4."@pt ;
              rdfs:label "participou de"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#pertenceATrilha
:pertenceATrilha rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ItemDoEvento ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :temAutor ;
                               owl:allValuesFrom :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :temAutor ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :pertenceATrilha ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :publicadoEm ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :temIdioma ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
                 rdfs:range :Trilha ;
                 rdfs:label "pertence à trilha"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#possuiAutor
:possuiAutor rdf:type owl:ObjectProperty ;
             rdfs:domain :Instituicao ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :possuiAutor ;
                           owl:allValuesFrom :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :possuiAutor ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :nomeInstituicao ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
             rdfs:range :Autor ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :afiliadoA ;
                          owl:allValuesFrom :Instituicao
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :afiliadoA ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Instituicao
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :nome ;
                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                        ] ;
             rdfs:comment "Inversa de afiliadoA; uma instituição pode ter um ou mais autores afiliados."@pt ;
             rdfs:label "possui autor afiliado"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#publicadoEm
:publicadoEm rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :ItemDoEvento ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temAutor ;
                           owl:allValuesFrom :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temAutor ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Autor
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :pertenceATrilha ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :publicadoEm ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :temIdioma ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
             rdfs:range :Edicao ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :ano ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isbn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :issn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :localidade ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
             rdfs:label "publicado em"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#temAutor
:temAutor rdf:type owl:ObjectProperty ;
          rdfs:domain :ItemDoEvento ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :temAutor ;
                        owl:allValuesFrom :Autor
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :temAutor ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass :Autor
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :pertenceATrilha ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :publicadoEm ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :temIdioma ;
                        owl:cardinality "1"^^xsd:nonNegativeInteger
                      ] ;
          rdfs:range :Autor ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :afiliadoA ;
                       owl:allValuesFrom :Instituicao
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :afiliadoA ;
                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                       owl:onClass :Instituicao
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :nome ;
                       owl:minCardinality "1"^^xsd:nonNegativeInteger
                     ] ;
          rdfs:label "tem autor"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#temIdioma
:temIdioma rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :ItemDoEvento ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temAutor ;
                         owl:allValuesFrom :Autor
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temAutor ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Autor
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :pertenceATrilha ;
                         owl:cardinality "1"^^xsd:nonNegativeInteger
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :publicadoEm ;
                         owl:cardinality "1"^^xsd:nonNegativeInteger
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temIdioma ;
                         owl:cardinality "1"^^xsd:nonNegativeInteger
                       ] ;
           rdfs:range :Idioma ;
           rdfs:label "tem idioma"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#temInstituicaoParticipante
:temInstituicaoParticipante rdf:type owl:ObjectProperty ;
                            rdfs:domain :Edicao ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :ano ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :isbn ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :issn ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty :localidade ;
                                          owl:cardinality "1"^^xsd:nonNegativeInteger
                                        ] ;
                            rdfs:range :Instituicao ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :possuiAutor ;
                                         owl:allValuesFrom :Autor
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :possuiAutor ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :Autor
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :nomeInstituicao ;
                                         owl:cardinality "1"^^xsd:nonNegativeInteger
                                       ] ;
                            rdfs:label "tem instituição participante"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#temTipoDeContribuicao
:temTipoDeContribuicao rdf:type owl:ObjectProperty ;
                       rdfs:domain :Artigo ,
                                   :ItemDoEvento ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :abordaTecnica ;
                                     owl:allValuesFrom :TemaDePesquisa
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :temAutor ;
                                     owl:allValuesFrom :Autor
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :temAutor ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :Autor
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :pertenceATrilha ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :publicadoEm ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :temIdioma ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :doi ;
                                     owl:allValuesFrom xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :palavraChave ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :doi ;
                                     owl:cardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                       rdfs:range :TipoDeContribuicao ;
                       rdfs:comment "Opcional no corpus atual, pois a planilha fornece a trilha do evento, não uma classificação de contribuição científica."@pt ;
                       rdfs:label "tem tipo de contribuição"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#temaRelacionadoCom
:temaRelacionadoCom rdf:type owl:ObjectProperty ,
                             owl:SymmetricProperty ;
                    rdfs:domain :TemaDePesquisa ;
                    rdfs:range :TemaDePesquisa ;
                    rdfs:comment "Dois temas que aparecem juntos em ao menos um artigo. Derivada pela regra R2."@pt ;
                    rdfs:label "tema relacionado com"@pt .


#################################################################
#    Data properties
#################################################################

###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ano
:ano rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :Edicao ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :ano ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :isbn ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :issn ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :localidade ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ;
     rdfs:range xsd:integer ;
     rdfs:label "ano"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#doi
:doi rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :Artigo ,
                 :ItemDoEvento ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :abordaTecnica ;
                   owl:allValuesFrom :TemaDePesquisa
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :temAutor ;
                   owl:allValuesFrom :Autor
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :temAutor ;
                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                   owl:onClass :Autor
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :pertenceATrilha ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :publicadoEm ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :temIdioma ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :doi ;
                   owl:allValuesFrom xsd:string
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :palavraChave ;
                   owl:minCardinality "1"^^xsd:nonNegativeInteger
                 ] ,
                 [ rdf:type owl:Restriction ;
                   owl:onProperty :doi ;
                   owl:cardinality "1"^^xsd:nonNegativeInteger
                 ] ;
     rdfs:range xsd:string ;
     rdfs:label "DOI"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#isbn
:isbn rdf:type owl:DatatypeProperty ,
               owl:FunctionalProperty ;
      rdfs:domain :Edicao ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :ano ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :isbn ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :issn ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :localidade ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ;
      rdfs:range xsd:string ;
      rdfs:comment "Identificador editorial da edição. Pode coincidir com o valor de outra edição."@pt ;
      rdfs:label "ISBN"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#issn
:issn rdf:type owl:DatatypeProperty ,
               owl:FunctionalProperty ;
      rdfs:domain :Edicao ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :ano ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :isbn ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :issn ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :localidade ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ;
      rdfs:range xsd:string ;
      rdfs:comment "ISSN associado à série dos anais. Pode se repetir entre edições."@pt ;
      rdfs:label "ISSN"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#link
:link rdf:type owl:DatatypeProperty ;
      rdfs:domain :ItemDoEvento ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :temAutor ;
                    owl:allValuesFrom :Autor
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :temAutor ;
                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                    owl:onClass :Autor
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :pertenceATrilha ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :publicadoEm ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :temIdioma ;
                    owl:cardinality "1"^^xsd:nonNegativeInteger
                  ] ;
      rdfs:range xsd:anyURI ;
      rdfs:label "link"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#linkEdicao
:linkEdicao rdf:type owl:DatatypeProperty ;
            rdfs:domain :Edicao ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :ano ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isbn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :issn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :localidade ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
            rdfs:range xsd:anyURI ;
            rdfs:label "link da edição"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#linkPagina
:linkPagina rdf:type owl:DatatypeProperty ;
            rdfs:domain :ItemDoEvento ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temAutor ;
                          owl:allValuesFrom :Autor
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temAutor ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Autor
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :pertenceATrilha ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :publicadoEm ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temIdioma ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
            rdfs:range xsd:anyURI ;
            rdfs:label "link da página"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#localidade
:localidade rdf:type owl:DatatypeProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Edicao ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :ano ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isbn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :issn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :localidade ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
            rdfs:range xsd:string ;
            rdfs:comment "Uma edição tem uma localidade. O mesmo valor pode ser reutilizado em várias edições; não há restrição de unicidade."@pt ;
            rdfs:label "localidade"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#nome
:nome rdf:type owl:DatatypeProperty ;
      rdfs:domain :Autor ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :afiliadoA ;
                    owl:allValuesFrom :Instituicao
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :afiliadoA ;
                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                    owl:onClass :Instituicao
                  ] ,
                  [ rdf:type owl:Restriction ;
                    owl:onProperty :nome ;
                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                  ] ;
      rdfs:range xsd:string ;
      rdfs:label "nome"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#nomeAlternativo
:nomeAlternativo rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Autor ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :afiliadoA ;
                               owl:allValuesFrom :Instituicao
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :afiliadoA ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Instituicao
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :nome ;
                               owl:minCardinality "1"^^xsd:nonNegativeInteger
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:label "nome alternativo"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#nomeInstituicao
:nomeInstituicao rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :Instituicao ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :possuiAutor ;
                               owl:allValuesFrom :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :possuiAutor ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :nomeInstituicao ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:label "nome da instituição"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#palavraChave
:palavraChave rdf:type owl:DatatypeProperty ;
              rdfs:domain :ItemDoEvento ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :temAutor ;
                            owl:allValuesFrom :Autor
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :temAutor ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :Autor
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :pertenceATrilha ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :publicadoEm ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :temIdioma ;
                            owl:cardinality "1"^^xsd:nonNegativeInteger
                          ] ;
              rdfs:range xsd:string ;
              rdfs:comment "Um item pode ter uma ou várias palavras-chave; a propriedade não é funcional."@pt ;
              rdfs:label "palavra-chave"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#palavraChaveAssociada
:palavraChaveAssociada rdf:type owl:DatatypeProperty ;
                       rdfs:domain :TemaDePesquisa ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Palavra-chave (em qualquer idioma) que indica que um artigo trata deste tema. Não funcional: um tema pode ter vários sinônimos. Usada pela regra R1."@pt ;
                       rdfs:label "palavra-chave associada"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#titulo
:titulo rdf:type owl:DatatypeProperty ;
        rdfs:domain :ItemDoEvento ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temAutor ;
                      owl:allValuesFrom :Autor
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temAutor ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass :Autor
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :pertenceATrilha ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :publicadoEm ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :temIdioma ;
                      owl:cardinality "1"^^xsd:nonNegativeInteger
                    ] ;
        rdfs:range xsd:string ;
        rdfs:label "título"@pt .


#################################################################
#    Classes
#################################################################

###  http://www.cin.ufpe.br/ontologias/wer-catalogo#Artigo
:Artigo rdf:type owl:Class ;
        rdfs:subClassOf :ItemDoEvento ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :abordaTecnica ;
                          owl:allValuesFrom :TemaDePesquisa
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temAutor ;
                          owl:allValuesFrom :Autor
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temAutor ;
                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onClass :Autor
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :pertenceATrilha ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :publicadoEm ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :temIdioma ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :doi ;
                          owl:allValuesFrom xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :palavraChave ;
                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :doi ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
        owl:disjointWith :ItemEspecial ;
        owl:hasKey ( :doi
                   ) ;
        rdfs:comment "Artigo científico identificado por um DOI."@pt ;
        rdfs:label "Artigo"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoColaborativo
:ArtigoColaborativo rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :temAutor ;
                                                                 owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                 owl:onClass :Autor
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :temAutor ;
                                                             owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :Autor
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                    rdfs:label "Artigo Colaborativo"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoDeAutoriaUnica
:ArtigoDeAutoriaUnica rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :temAutor ;
                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass :Autor
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :temAutor ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass :Autor
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:label "Artigo de Autoria Única"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoEmLinguaEstrangeira
:ArtigoEmLinguaEstrangeira rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                                      [ rdf:type owl:Class ;
                                                                        owl:complementOf [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty :temIdioma ;
                                                                                           owl:hasValue :Portugues
                                                                                         ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                                  [ rdf:type owl:Class ;
                                                                    owl:complementOf [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty :temIdioma ;
                                                                                       owl:hasValue :Portugues
                                                                                     ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                           rdfs:label "Artigo em Língua Estrangeira"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoEmPortugues
:ArtigoEmPortugues rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :temIdioma ;
                                                                owl:hasValue :Portugues
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :temIdioma ;
                                                            owl:hasValue :Portugues
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
                   rdfs:label "Artigo em Português"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoInterinstitucional
:ArtigoInterinstitucional rdf:type owl:Class ;
                          rdfs:subClassOf :Artigo ,
                                          :ItemDoEvento ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :abordaTecnica ;
                                            owl:allValuesFrom :TemaDePesquisa
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :temAutor ;
                                            owl:allValuesFrom :Autor
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :temAutor ;
                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass :Autor
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :pertenceATrilha ;
                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :publicadoEm ;
                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :temIdioma ;
                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :doi ;
                                            owl:allValuesFrom xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :palavraChave ;
                                            owl:minCardinality "1"^^xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :doi ;
                                            owl:cardinality "1"^^xsd:nonNegativeInteger
                                          ] ;
                          rdfs:comment "Artigo com autores de instituições diferentes. Classe preenchida pela regra R3 (subclasse simples, não definida por equivalência, porque a condição exige junção que DL não expressa)."@pt ;
                          rdfs:label "Artigo Interinstitucional"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoMultitematico
:ArtigoMultitematico rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :abordaTecnica ;
                                                                  owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass :TemaDePesquisa
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :abordaTecnica ;
                                                              owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                              owl:onClass :TemaDePesquisa
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                     rdfs:label "Artigo Multitemático"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoSobreElicitacao
:ArtigoSobreElicitacao rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :abordaTecnica ;
                                                                    owl:someValuesFrom :TecnicaDeElicitacao
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :abordaTecnica ;
                                                                owl:someValuesFrom :TecnicaDeElicitacao
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:label "Artigo sobre Elicitação"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ArtigoSobreModelagem
:ArtigoSobreModelagem rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Artigo
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :abordaTecnica ;
                                                                   owl:someValuesFrom :TecnicaDeModelagem
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf [ owl:intersectionOf ( :Artigo
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :abordaTecnica ;
                                                               owl:someValuesFrom :TecnicaDeModelagem
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:label "Artigo sobre Modelagem"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#Autor
:Autor rdf:type owl:Class ;
       rdfs:subClassOf [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:allValuesFrom :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :afiliadoA ;
                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Instituicao
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :nome ;
                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                       ] ;
       rdfs:label "Autor"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#Edicao
:Edicao rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty :ano ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isbn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :issn ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :localidade ;
                          owl:cardinality "1"^^xsd:nonNegativeInteger
                        ] ;
        rdfs:comment "Uma edição/ano do WER."@pt ;
        rdfs:label "Edição"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#Idioma
:Idioma rdf:type owl:Class ;
        rdfs:label "Idioma"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#Instituicao
:Instituicao rdf:type owl:Class ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                               owl:onProperty :possuiAutor ;
                               owl:allValuesFrom :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :possuiAutor ;
                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass :Autor
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :nomeInstituicao ;
                               owl:cardinality "1"^^xsd:nonNegativeInteger
                             ] ;
             rdfs:label "Instituição"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ItemDoEvento
:ItemDoEvento rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :temAutor ;
                                owl:allValuesFrom :Autor
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :temAutor ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Autor
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :pertenceATrilha ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :publicadoEm ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :temIdioma ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "Item publicado ou disponibilizado em uma edição do WER, incluindo artigos, prefácio e tutorial."@pt ;
              rdfs:label "Item do Evento"@pt .


###  http://www.cin.ufpe.br/ontologias/wer-catalogo#ItemEspecial
:ItemEspecial rdf:type owl:Class ;
              rdfs:subClassOf :ItemDoEvento ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :temAutor ;
                                owl:allValuesFrom :Autor
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :temAutor ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Autor
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :pertenceATrilha ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :publicadoEm ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :temIdioma ;
                                owl:cardinality "1"^^xsd:nonNegativeInteger
                              ] ;
