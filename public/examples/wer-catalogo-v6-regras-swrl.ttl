#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :Artigo
                        [ rdf:type owl:Class ;
                          owl:complementOf [ rdf:type owl:Restriction ;
                                             owl:onProperty :temIdioma ;
                                             owl:hasValue :Portugues
                                           ]
                        ]
                      ) ;
   rdf:type owl:Class ;
   rdfs:subClassOf :ArtigoEmLinguaEstrangeira
 ] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :abordaTecnica ;
                         owl:someValuesFrom :TecnicaDeElicitacao
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoSobreElicitacao
] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :abordaTecnica ;
                         owl:someValuesFrom :TecnicaDeModelagem
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoSobreModelagem
] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temIdioma ;
                         owl:hasValue :Portugues
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoEmPortugues
] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :abordaTecnica ;
                         owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                         owl:onClass :TemaDePesquisa
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoMultitematico
] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temAutor ;
                         owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                         owl:onClass :Autor
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoColaborativo
] .


[ owl:intersectionOf ( :Artigo
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :temAutor ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Autor
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf :ArtigoDeAutoriaUnica
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Autor
                :Edicao
                :Instituicao
                :ItemDoEvento
                :TemaDePesquisa
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :TecnicaDeElicitacao
                :TecnicaDeIA
                :TecnicaDeModelagem
                :TecnicaDeValidacao
                :TemaDePrivacidadeEEtica
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :Espanhol
                        :Ingles
                        :Portugues
                      )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :TrilhaFerramentas
                        :TrilhaIndustria
                        :TrilhaMestradoDoutorado
                        :TrilhaPesquisa
                        :TrilhaPrefacio
                        :TrilhaTutorial
                      )
] .


#################################################################
#    Rules
#################################################################

<urn:swrl#a> rdf:type swrl:Variable .

<urn:swrl#t1> rdf:type swrl:Variable .

<urn:swrl#t2> rdf:type swrl:Variable .

<urn:swrl#x> rdf:type swrl:Variable .

<urn:swrl#y> rdf:type swrl:Variable .

<urn:swrl#nx> rdf:type swrl:Variable .

<urn:swrl#ny> rdf:type swrl:Variable .

<urn:swrl#i> rdf:type swrl:Variable .

<urn:swrl#j> rdf:type swrl:Variable .

<urn:swrl#ni> rdf:type swrl:Variable .

<urn:swrl#nj> rdf:type swrl:Variable .

<urn:swrl#k> rdf:type swrl:Variable .

<urn:swrl#t> rdf:type swrl:Variable .

<urn:swrl#it> rdf:type swrl:Variable .

<urn:swrl#inst> rdf:type swrl:Variable .

<urn:swrl#e> rdf:type swrl:Variable .

[ rdfs:comment "Artigo com dois autores distintos (nomes diferentes) afiliados a instituições de nomes diferentes. Autores com dupla afiliação podem inflar a contagem, pois SWRL não tem negação."@pt ;
   rdfs:label "R3_ArtigoInterinstitucional" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate :Artigo ;
                           swrl:argument1 <urn:swrl#a>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                      swrl:propertyPredicate :temAutor ;
                                      swrl:argument1 <urn:swrl#a> ;
                                      swrl:argument2 <urn:swrl#x>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                 swrl:propertyPredicate :temAutor ;
                                                 swrl:argument1 <urn:swrl#a> ;
                                                 swrl:argument2 <urn:swrl#y>
                                               ] ;
                                     rdf:rest [ rdf:type swrl:AtomList ;
                                                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                            swrl:propertyPredicate :nome ;
                                                            swrl:argument1 <urn:swrl#x> ;
                                                            swrl:argument2 <urn:swrl#nx>
                                                          ] ;
                                                rdf:rest [ rdf:type swrl:AtomList ;
                                                           rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                       swrl:propertyPredicate :nome ;
                                                                       swrl:argument1 <urn:swrl#y> ;
                                                                       swrl:argument2 <urn:swrl#ny>
                                                                     ] ;
                                                           rdf:rest [ rdf:type swrl:AtomList ;
                                                                      rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                                  swrl:builtin swrlb:notEqual ;
                                                                                  swrl:arguments ( <urn:swrl#nx>
                                                                                                   <urn:swrl#ny>
                                                                                                 )
                                                                                ] ;
                                                                      rdf:rest [ rdf:type swrl:AtomList ;
                                                                                 rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                             swrl:propertyPredicate :afiliadoA ;
                                                                                             swrl:argument1 <urn:swrl#x> ;
                                                                                             swrl:argument2 <urn:swrl#i>
                                                                                           ] ;
                                                                                 rdf:rest [ rdf:type swrl:AtomList ;
                                                                                            rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                                                                                                        swrl:propertyPredicate :afiliadoA ;
                                                                                                        swrl:argument1 <urn:swrl#y> ;
                                                                                                        swrl:argument2 <urn:swrl#j>
                                                                                                      ] ;
                                                                                            rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                       rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                                                                   swrl:propertyPredicate :nomeInstituicao ;
                                                                                                                   swrl:argument1 <urn:swrl#i> ;
                                                                                                                   swrl:argument2 <urn:swrl#ni>
                                                                                                                 ] ;
                                                                                                       rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                  rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                                                                                              swrl:propertyPredicate :nomeInstituicao ;
                                                                                                                              swrl:argument1 <urn:swrl#j> ;
                                                                                                                              swrl:argument2 <urn:swrl#nj>
                                                                                                                            ] ;
                                                                                                                  rdf:rest [ rdf:type swrl:AtomList ;
                                                                                                                             rdf:first [ rdf:type swrl:BuiltinAtom ;
                                                                                                                                         swrl:builtin swrlb:notEqual ;
                                                                                                                                         swrl:arguments ( <urn:swrl#ni>
                                                                                                                                                          <urn:swrl#nj>
                                                                                                                                                        )
                                                                                                                                       ] ;
                                                                                                                             rdf:rest rdf:nil
                                                                                                                           ]
                                                                                                                ]
                                                                                                     ]
                                                                                          ]
                                                                               ]
                                                                    ]
                                                         ]
                                              ]
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate :ArtigoInterinstitucional ;
                           swrl:argument1 <urn:swrl#a>
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ rdfs:comment "Deriva abordaTecnica a partir das palavras-chave do artigo: se o artigo tem uma palavra-chave igual a uma palavraChaveAssociada de um tema, ele aborda esse tema. Une sinônimos em PT, EN e ES."@pt ;
   rdfs:label "R1_TemaPorPalavraChave" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate :Artigo ;
                           swrl:argument1 <urn:swrl#a>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                      swrl:propertyPredicate :palavraChave ;
                                      swrl:argument1 <urn:swrl#a> ;
                                      swrl:argument2 <urn:swrl#k>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                                                 swrl:propertyPredicate :palavraChaveAssociada ;
                                                 swrl:argument1 <urn:swrl#t> ;
                                                 swrl:argument2 <urn:swrl#k>
                                               ] ;
                                     rdf:rest rdf:nil
                                   ]
                        ]
             ] ;
   swrl:head [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate :abordaTecnica ;
                           swrl:argument1 <urn:swrl#a> ;
                           swrl:argument2 <urn:swrl#t>
                         ] ;
               rdf:rest rdf:nil
             ]
 ] .

[ rdfs:comment "Se um autor afiliado a uma instituição assina um item publicado em uma edição, a instituição participouDe essa edição (junção de 3 relações, que DL puro não expressa)."@pt ;
   rdfs:label "R4_InstituicaoParticipouDaEdicao" ;
   rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:IndividualPropertyAtom ;
                           swrl:propertyPredicate :temAutor ;
                           swrl:argument1 <urn:swrl#it> ;
                           swrl:argument2 <urn:swrl#x>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
